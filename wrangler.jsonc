// Cloudflare Workers + Pages config for the urbanist-atlas SPA.
//
// We deploy the Vite-built SPA as Workers Static Assets (no Worker
// code — pure static serving with SPA fallback).
//
// SPA fallback comes from `assets.not_found_handling` below — any
// path that doesn't match a real file under ./web/dist serves
// /index.html with a 200 status; React Router then handles the
// route client-side.
//
// Design doc: docs/superpowers/specs/2026-05-21-fly-deploy-design.md
// Runbook:    docs/deploy.md § Cloudflare Workers + Pages + DNS
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urbanist-atlas",
  "compatibility_date": "2026-05-21",

  "assets": {
    // Points at the Vite output. Build runs `cd web && npm ci &&
    // npm run build` (Cloudflare UI's "Build command"), producing
    // web/dist relative to the repo root.
    "directory": "./web/dist",

    // SPA fallback: any path that doesn't match a real file in
    // ./web/dist (e.g. /browse, /about, /r/10001) serves
    // /index.html with a 200 status. React Router then handles the
    // route client-side. This is the Workers Static Assets
    // equivalent of the Pages `_redirects` rule
    //   /*    /index.html   200
    "not_found_handling": "single-page-application"
    // Response-header policy (CSP, Referrer-Policy, etc.) lives in
    // `web/public/_headers`, which Vite copies to `web/dist/_headers`
    // and Workers Static Assets serves. Wrangler doesn't expose a
    // headers field in this config; the `_headers` file is the
    // documented surface. See docs/deploy.md for the policy notes.
  },

  // Workers Logs. This logs Worker *invocations*; with a pure
  // static-assets deploy (no Worker code) there is nothing to log, so
  // it is effectively inert today — kept as a sensible default for if a
  // Worker is ever added. NOTE: this is NOT the site's audience
  // analytics. Page views / visitors come from Cloudflare Web Analytics
  // (a cookieless beacon Cloudflare injects at the edge — enabled in
  // the dashboard, not configured in this repo; the CSP in
  // web/public/_headers allow-lists its origins). `head_sampling_rate`
  // 1.0 = ingest all, and only matters once a Worker exists.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
