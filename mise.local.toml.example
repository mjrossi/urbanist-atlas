# Optional machine-local mise overrides — copy to mise.local.toml
# (gitignored) only if you need to override what's already committed.
#
# In practice you probably don't need this file:
#   - mise.toml pins the language runtimes and project tooling
#   - mise.development.toml provides committed dev defaults
#     (seed dir, dev admin token, log format) when MISE_ENV=development
#   - mise.ci.toml does the same for CI when MISE_ENV=ci
#
# Use mise.local.toml for things like:
#   - pointing at a seed-data fork (URBANIST_SEED_DIR)
#   - a personal admin token for the admin queue
#   - testing against a staging API

# [env]
# URBANIST_SEED_DIR    = "/path/to/your/seed/fork"
# URBANIST_ADMIN_TOKEN = "my-personal-dev-token"
#
# The `usage` and `submissions` just recipes read the admin bearer from
# URBANIST_ADMIN_TOKEN. To point them at PRODUCTION (their default base),
# it must be the value of the Fly secret of the same name, not a dev token.
#
# Do NOT put that value in THIS file. mise loads mise.{env}.toml *after*
# mise.local.toml, so under MISE_ENV=development the dev token in
# mise.development.toml wins and every admin recipe 401s against
# production. Precedence, lowest to highest:
#
#   mise.toml < mise.local.toml < mise.development.toml
#             < mise.development.local.toml
#
# So the production token belongs in mise.development.local.toml
# (gitignored, same ergonomics). That also keeps `just api-run` on the
# dev token for a locally-run server, which is what you want.
#
# For `just fly-prom` (Fly managed Prometheus, ~30d of latency/5xx):
# FLY_PROMETHEUS_TOKEN = "FlyV1 fm2_..."   # full value, prefix included
# FLY_ORG_SLUG         = "personal"        # Slug column of `flyctl orgs list`
#
# Secret for scripts/verify-org-urls.compose.yml (gluetun + Proton VPN).
# Generate at https://account.protonvpn.com/downloads → WireGuard.
# WIREGUARD_PRIVATE_KEY = "…"
# SERVER_COUNTRIES      = "United States"
