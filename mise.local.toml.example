# Optional machine-local mise overrides — copy to mise.local.toml
# (gitignored) only if you need to override what's already committed.
#
# In practice you probably don't need this file:
#   - mise.toml pins the language runtimes and project tooling
#   - mise.development.toml provides committed dev defaults
#     (DB URL, dev admin token, log format) when MISE_ENV=development
#   - mise.ci.toml does the same for CI when MISE_ENV=ci
#
# Use mise.local.toml for things like:
#   - using a system Postgres instead of the docker-managed dev DB
#     (the default in mise.development.toml is the :55432 docker
#     container — see `just pg-up`)
#   - alternate local DB URL (different host / port / credentials)
#   - a personal admin token for the admin queue
#   - testing against a staging API

# [env]
# DATABASE_URL         = "postgres://urbanist@localhost:5432/atlas?sslmode=disable"
# URBANIST_ADMIN_TOKEN = "my-personal-dev-token"
