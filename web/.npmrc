# eslint-plugin-jsx-a11y@6.10.2 still caps its `eslint` peer range at ^9, but
# it is pure JSX-AST linting with no dependency on ESLint internals and runs
# fine on ESLint 10 (our pinned major). Tolerate the stale peer declaration so
# `npm install` / `npm ci` resolve. Remove this line once jsx-a11y ships an
# ESLint 10 peer range (track: jsx-eslint/eslint-plugin-jsx-a11y).
legacy-peer-deps=true
