# web/.env.example
#
# Copy to web/.env.local for local dev. Vite reads .env.local
# automatically; never commit it (the repo .gitignore handles that).
#
# Cloudflare Pages overrides these via the dashboard's environment
# variable settings (one set for Production, one for Preview). The
# values committed here are placeholders.

# Where the SPA finds the API. The default in src/lib/api.ts is
# http://localhost:8080 (matches `cd ../api && just api-run`).
# Cloudflare Workers + Pages should point this at the deployed API host:
#   - prod: https://api.urbanistatlas.com
VITE_API_BASE=http://localhost:8080

# Shared secret for the Phase 1 lockdown — must match the API's
# URBANIST_CLIENT_SECRET. Empty (or absent) means the SPA sends no
# X-Atlas-Client header and the backend's empty-secret no-op lets
# requests through; that's the local-dev default. Set this on
# Cloudflare Pages to the same value as the Fly secret.
VITE_API_CLIENT_SECRET=
