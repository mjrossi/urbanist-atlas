# https://editorconfig.org — most editors pick this up automatically.
# Go's tooling enforces tabs separately (gofmt); this file is mainly for
# the TS/JS/CSS/YAML/Markdown sides so contributors don't fight their
# editors over indentation when adding a tooling change.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{ts,tsx,js,jsx,json,yaml,yml,css,html,md}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

# justfile recipes are bash; preserve tabs for heredoc safety.
[justfile]
indent_style = space
indent_size = 4
